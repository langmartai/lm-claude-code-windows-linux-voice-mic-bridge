# Copy to ~/.config/windowsmic-bridge/config.env (install.sh does this on first run).
# Sourced by windowsmic-listen.sh and read by windowsmic-health.py.
# v0.2 removed all cross-host secrets -- no SSH key required any more.

# TCP port the listener accepts on (also what the Windows side connects to).
PORT=9999

# HTTP port the /health daemon serves on. The Windows monitor polls this.
HEALTH_PORT=9998

# Address the /health daemon binds to. Default 0.0.0.0 makes it reachable from
# Windows on the same LAN. Use 127.0.0.1 to restrict to local-only access.
HEALTH_BIND=0.0.0.0

# Sampler tuning (defaults shown).
# CHECK_INTERVAL=15      # seconds between source-level samples
# SILENT_LIMIT=3         # consecutive zero-peak samples before reporting zombie_likely=true
# SAMPLE_SEC=3.0         # length of each sampling recording
# SKIP_HEAD_SEC=1.0      # parecord startup latency to skip
# HISTORY_LEN=20         # samples kept in /health "history" array
